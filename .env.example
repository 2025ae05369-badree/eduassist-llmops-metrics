# Copy to .env and fill in only if needed. All variables are OPTIONAL.
# Never commit .env or paste real values into the notebook.

# Hugging Face access token — not required for the default ungated model (Qwen/Qwen2.5-3B-Instruct). 
# Only needed for gated models or higher download rate limits.
HF_TOKEN=

# MLflow tracking backend. Defaults to sqlite:///mlflow.db (required for the Prompt Registry).
MLFLOW_TRACKING_URI=
